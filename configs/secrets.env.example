# Copy to .env, fill in real values, and NEVER commit .env.
# Prefer AWS Secrets Manager / SSM Parameter Store over even a local
# .env where possible — this file is meant for local/dev convenience
# only, not for cluster configs (those should use PasswordSecretArn,
# see configs/cluster-config-slurm-accounting-example.yaml).

AWS_ACCOUNT_ID=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# License server
LICENSE_SERVER_HOST=          # prefer a DNS name over a raw IP
ANSYS_LICENSE_PORT=1055
ANSYS_LI_PORT=2325

# SLURM accounting DB (prefer PasswordSecretArn in the cluster config
# instead of a plaintext value here wherever possible)
SLURM_DB_HOST=
SLURM_DB_ADMIN_USER=
SLURM_DB_SECRET_ARN=
